# ÖTS ortam değişkenleri.
# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.
# `.env*` dosyaları .gitignore içinde — gerçek değerler depoya girmez.

# Neon Postgres bağlantı adresi.
# neon.com → projeniz → Connection string → kopyalayın.
# "?sslmode=require" kısmını olduğu gibi bırakın.
DATABASE_URL=postgresql://kullanici:sifre@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Oturum çerezini imzalayan gizli anahtar.
# Üretmek için:  openssl rand -base64 32
# Bu değeri değiştirmek tüm açık oturumları geçersiz kılar.
SESSION_SECRET=

# İlk koç hesabı — yalnızca `npm run ots:koc` bir kez çalışırken kullanılır.
# Hesap açıldıktan sonra bu iki satırı silebilirsiniz.
ILK_KOC_EMAIL=
ILK_KOC_SIFRE=
